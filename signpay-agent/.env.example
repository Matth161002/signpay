# Copy to .env for local Bun development, then replace placeholders.
# Do not commit .env or any file containing real credentials.

# Astropods AI Gateway
ASTRO_GATEWAY_URL=your_astropods_gateway_url
ASTRO_GATEWAY_API_KEY=your_astropods_gateway_api_key

# Must match SIGNPAY_AGENT_API_KEY in the main application's .env.local
SIGNPAY_AGENT_API_KEY=replace_with_the_same_random_secret_of_at_least_32_characters

# Optional
# MODEL_DEFAULT=claude-sonnet-4-6
# PORT=8080
# OTEL_EXPORTER_OTLP_ENDPOINT=
