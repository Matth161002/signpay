# PostgreSQL database (Neon)
# Use the pooled connection string from Neon. Keep the real value private.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local or put real credentials in this file.

# PayPal Developer Sandbox application
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BUSINESS_EMAIL=your_sandbox_business_account_email
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# SignPay AI assessment agent
# Local Astropods development commonly exposes the agent at port 3200.
SIGNPAY_AGENT_URL=http://localhost:3200
# Use the same random secret in the main app and the agent configuration.
# Generate a value of at least 32 characters.
SIGNPAY_AGENT_API_KEY=replace_with_a_random_secret_of_at_least_32_characters
